---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import Header_Doc from "../components/Header_Doc.astro";
import Card from "../components/Card.astro";
---
<Layout title="MIS Home">
    <main class="w-screen h-screen flex flex-col items-center ">
        <Header_Doc/>
        <section class=" w-full px-20 gap-5 py-2">
            <a 
                class="flex w-full max-h-56 min-h-32 border-separate bg-slate-200 p-5 rounded-lg gap-5 items-center hover:shadow-lg transition-shadow duration-700" 
                href="/estudiante"
            >
                <img src="/imgs/tok.jpg" alt="frente" width="250" height="150" />
                Estudiante: Juan Esteban Güiza
            </a>
        </section>
    </main>
    <Footer/>
</Layout>